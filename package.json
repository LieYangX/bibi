{
    "name": "bibi",
    "version": "4.0.0",
    "description": "笔笔个人记账桌面应用",
    "main": "./out/main/index.js",
    "author": "lieyang",
    "scripts": {
        "postinstall": "electron-builder install-app-deps && node scripts/clean-onnxruntime.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "test": "vitest run --config vitest.config.ts",
        "test:db": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
        "test:watch": "vitest",
        "check": "npm run format:check && npm run lint -- --max-warnings=0 && npm run typecheck && npm run test && npm run test:db",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "devtools": "npx @ai-sdk/devtools",
        "icons": "node scripts/generate-icons.mjs",
        "build": "npm run icons && npm run check && electron-vite build",
        "build:unpack": "npm run icons && npm run check && electron-vite build && electron-builder --dir",
        "build:win": "npm run icons && npm run check && electron-vite build && node scripts/clean-onnxruntime.mjs && electron-builder --win",
        "build:mac": "npm run icons && npm run check && electron-vite build && node scripts/clean-onnxruntime.mjs && electron-builder --mac",
        "build:linux": "npm run icons && npm run check && electron-vite build && node scripts/clean-onnxruntime.mjs && electron-builder --linux"
    },
    "dependencies": {
        "@ai-sdk/deepseek": "^3.0.7",
        "@ai-sdk/mcp": "^2.0.12",
        "@electron-toolkit/utils": "^4.0.0",
        "@huggingface/transformers": "^4.2.0",
        "@pinixai/weixin-bot": "^1.2.0",
        "@types/exceljs": "^0.5.3",
        "ai": "^7.0.22",
        "better-sqlite3": "12.11.1",
        "bonjour-service": "^1.4.4",
        "csv-parse": "^5.6.0",
        "drizzle-orm": "^0.45.2",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "iconv-lite": "^0.6.3",
        "marked": "^18.0.6",
        "mathjs": "^15.2.0",
        "opencc-js": "^1.4.0",
        "qrcode": "^1.5.4",
        "unzipper": "^0.12.5",
        "zod": "^4.4.3",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@ai-sdk/devtools": "^1.0.6",
        "@electron-toolkit/eslint-config-prettier": "3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@lucide/vue": "1.23.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/express": "^5.0.6",
        "@types/node": "^22.19.1",
        "@types/qrcode": "^1.5.5",
        "@types/unzipper": "^0.10.11",
        "@vitejs/plugin-vue": "^6.0.2",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.10",
        "echarts": "6.1.0",
        "electron": "39.8.10",
        "electron-builder": "26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-vue": "^10.6.2",
        "pinia": "2.3.1",
        "png-to-ico": "^3.0.1",
        "pngjs": "^7.0.0",
        "prettier": "^3.7.4",
        "typescript": "^5.9.3",
        "vite": "^7.2.6",
        "vitest": "^4.1.10",
        "vue": "3.5.39",
        "vue-echarts": "8.0.1",
        "vue-eslint-parser": "^10.2.0",
        "vue-router": "4.6.4",
        "vue-tsc": "^3.1.6"
    },
    "overrides": {
        "exceljs": {
            "uuid": "11.1.1"
        }
    }
}
