{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/typescript/node",
    "tsBuildInfoFile": "node_modules/.cache/typescript/tsconfig.node.tsbuildinfo",
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@pinixai/weixin-bot": ["node_modules/@pinixai/weixin-bot/src/index.ts"]
    },
    "types": ["electron-vite/node"]
  }
}
